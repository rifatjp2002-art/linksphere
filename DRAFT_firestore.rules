rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable validation helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHandle(username) {
      return username is string && username.size() >= 2 && username.size() <= 40 && username.matches('^[a-z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity 1: Private User Account (/users/{userId})
    function isValidUserDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'username', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'username', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 1000
        && isValidHandle(data.username)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity 2: Public Bio Profile (/profiles/{username})
    function isValidProfileDoc(data, username) {
      return data.keys().hasAll([
          'ownerId', 'username', 'displayName', 'bio', 'location', 'pronouns',
          'avatarUrl', 'bannerUrl', 'isVerified', 'badgeText', 'socials',
          'links', 'theme', 'widgets', 'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'username', 'displayName', 'bio', 'location', 'pronouns',
          'avatarUrl', 'bannerUrl', 'isVerified', 'badgeText', 'socials',
          'links', 'theme', 'widgets', 'published', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && isValidHandle(data.username) && data.username == username
        && data.displayName is string && data.displayName.size() <= 100
        && data.bio is string && data.bio.size() <= 300
        && data.location is string && data.location.size() <= 100
        && data.pronouns is string && data.pronouns.size() <= 40
        && data.avatarUrl is string && data.avatarUrl.size() <= 1000
        && data.bannerUrl is string && data.bannerUrl.size() <= 1000
        && data.isVerified is bool
        && data.badgeText is string && data.badgeText.size() <= 50
        && data.socials is list && data.socials.size() <= 20 && (data.socials.size() == 0 || data.socials[0] is map)
        && data.links is list && data.links.size() <= 50 && (data.links.size() == 0 || data.links[0] is map)
        && data.theme is map && data.theme.keys().size() <= 25
        && data.widgets is map && data.widgets.keys().size() <= 20
        && data.published is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity 3: Analytics Event (/profiles/{username}/events/{eventId})
    function isValidAnalyticsEvent(data, username) {
      return data.keys().hasAll([
          'ownerId', 'username', 'type', 'linkId', 'linkTitle',
          'device', 'referrer', 'dayKey', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'username', 'type', 'linkId', 'linkTitle',
          'device', 'referrer', 'dayKey', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && isValidHandle(data.username) && data.username == username
        && data.type in ['view', 'click']
        && data.linkId is string && data.linkId.size() <= 100
        && data.linkTitle is string && data.linkTitle.size() <= 120
        && (data.type == 'view' || data.linkId.size() > 0)
        && data.device in ['mobile', 'desktop', 'tablet']
        && data.referrer is string && data.referrer.size() <= 80
        && data.dayKey is string && data.dayKey.size() == 10 && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    // Private User Accounts (strictly owner-only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidUserDoc(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidUserDoc(incoming()) && (
        isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'username', 'updatedAt'])
      );
      allow delete: if false;
    }

    // Public Bio Profiles
    match /profiles/{username} {
      allow get: if isValidId(username) && (
        resource == null || existing().published == true || (isSignedIn() && existing().ownerId == request.auth.uid)
      );
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(username)
        && isValidProfileDoc(incoming(), username)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidProfileDoc(incoming(), username) && (
        isVerifiedUser() && isValidId(username)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'bio', 'location', 'pronouns', 'avatarUrl', 'bannerUrl',
          'isVerified', 'badgeText', 'socials', 'links', 'theme', 'widgets',
          'published', 'updatedAt'
        ])
      );
      allow delete: if isSignedIn() && isVerifiedUser() && isValidId(username)
        && existing().ownerId == request.auth.uid;

      // Visitor Analytics Events Subcollection
      match /events/{eventId} {
        allow get: if isSignedIn() && isValidId(username) && isValidId(eventId)
          && existing().ownerId == request.auth.uid;
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(username) && isValidId(eventId)
          && isValidAnalyticsEvent(incoming(), username)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/profiles/$(username))
          && get(/databases/$(database)/documents/profiles/$(username)).data.published == true
          && get(/databases/$(database)/documents/profiles/$(username)).data.ownerId == incoming().ownerId;
        allow update: if false;
        allow delete: if isSignedIn() && isVerifiedUser() && isValidId(username) && isValidId(eventId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
